# Copy to .env and fill in. .env is gitignored — never commit it.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres runs in Docker on 5433 (5432 is taken by another project on this machine):
#   docker run -d --name studyai-pg \
#     -e POSTGRES_USER=studyai -e POSTGRES_PASSWORD=studyai -e POSTGRES_DB=studyai_db \
#     -p 5433:5432 -v studyai-pgdata:/var/lib/postgresql/data pgvector/pgvector:pg16
POSTGRES_DB=studyai_db
POSTGRES_USER=studyai
POSTGRES_PASSWORD=studyai
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Answer generation: gemini (free tier, default) | anthropic | mock
LLM_PROVIDER=gemini

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# gemini-2.0-flash and 2.5-flash are retired / closed to new keys.
GEMINI_MODEL=gemini-3.7-flash

# Only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Retrieval tuning — see docs/superpowers/specs/ for what these mean
CHUNK_SIZE_WORDS=300
CHUNK_OVERLAP_WORDS=50
RETRIEVAL_TOP_K=4
RETRIEVAL_MAX_DISTANCE=0.7
MAX_UPLOAD_SIZE_MB=50
